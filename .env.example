# Copie para .env e preencha. Nunca commite o .env.

# Senha do painel (/painel)
ADMIN_PASSWORD=

# Chave da API da Claude (console.anthropic.com). Sem ela, toda foto vai para aprovação manual.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na moderação (padrão claude-opus-5-5)
# MODERACAO_MODEL=claude-opus-5-5

# Evolution API. Hoje roda neste computador (localhost:8081 no host). Dentro do Docker o app
# alcança como evolution-api:8080; rodando o app fora do Docker (npm run dev), o padrão é http://localhost:8081.
# Só mude se o Evolution for para outro servidor:
# EVOLUTION_URL=https://evolution.seudominio.com.br
# Chave da Evolution (a mesma usada pelo serviço evolution-api do docker-compose)
AUTHENTICATION_API_KEY=troque-esta-chave
# Instância já pareada no Evolution
EVOLUTION_INSTANCE=Denilson
# Segredo que protege o webhook. Gere com: openssl rand -hex 16
# Deixe VAZIO para não ligar o WhatsApp (o telão funciona com o envio pela página web).
WEBHOOK_SECRET=

# Endereço que os celulares dos convidados alcançam (usado no QR do modo "página de envio")
PUBLIC_URL=http://192.168.3.32:3000

# Opcional: menções em story do Instagram (conta profissional + token do painel da Meta)
INSTAGRAM_TOKEN=
# ID da conta profissional do Instagram
INSTAGRAM_ID=
